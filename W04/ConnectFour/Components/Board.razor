@inject GameState State

<div style="margin-bottom: 1rem;">
    @winnerMessage
    <button style="@ResetStyle" @onclick="ResetGame">Reset the game</button>
    <br />
    <span class="text-danger">@errorMessage</span>
    <span>@CurrentTurn</span>
</div>

<div style="display:grid; grid-template-columns: repeat(7, 60px); gap: 8px; margin-bottom: 12px;">
    @for (byte col = 0; col < 7; col++)
    {
        var c = col;
        <button class="btn btn-sm btn-secondary" @onclick="() => PlayPiece(c)">▼</button>
    }
</div>

<div style="display:grid; grid-template-columns: repeat(7, 60px); gap: 8px; background:@BoardColor; padding:12px; width:max-content; border-radius:12px;">
    @for (int row = 0; row < 6; row++)
    {
        @for (int col = 0; col < 7; col++)
        {
            var cell = State.GetCell(row, col);
            var color = cell switch
            {
                1 => Player1Color,
                2 => Player2Color,
                _ => "#ffffff"
            };

            <div style="
                width:60px;
                height:60px;
                border-radius:50%;
                background-color:@color;
                border:3px solid #444;
                display:flex;
                align-items:center;
                justify-content:center;
                font-weight:bold;
                color:black;">
                @(cell == 0 ? "" : cell.ToString())
            </div>
        }
    }
</div>

@code {
    [Parameter] public string BoardColor { get; set; } = "#ffff00";
    [Parameter] public string Player1Color { get; set; } = "#ff0000";
    [Parameter] public string Player2Color { get; set; } = "#0000ff";

    private string winnerMessage = string.Empty;
    private string errorMessage = string.Empty;

    private string CurrentTurn => string.IsNullOrEmpty(winnerMessage)
        ? $"Player {State.PlayerTurn}'s Turn"
        : "";

    private string ResetStyle => string.IsNullOrEmpty(winnerMessage)
        ? "display:none;"
        : "";

    protected override void OnInitialized()
    {
        State.ResetBoard();
    }

    private void PlayPiece(byte col)
    {
        errorMessage = string.Empty;

        try
        {
            State.PlayPiece(col);
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }

        winnerMessage = State.CheckForWin() switch
        {
            GameState.WinState.Player1_Wins => "Player 1 Wins!",
            GameState.WinState.Player2_Wins => "Player 2 Wins!",
            GameState.WinState.Tie => "It's a tie!",
            _ => ""
        };

        StateHasChanged();
    }

    private void ResetGame()
    {
        State.ResetBoard();
        winnerMessage = string.Empty;
        errorMessage = string.Empty;
        StateHasChanged();
    }
}